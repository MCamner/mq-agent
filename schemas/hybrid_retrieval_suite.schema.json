{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mq.hybrid-retrieval-suite.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": {"const": "mq.hybrid-retrieval-suite.v1"},
    "catalog": {"type": "string", "minLength": 1},
    "semantic_index": {"type": "string", "minLength": 1},
    "semantic_model": {"type": "string", "minLength": 1, "maxLength": 120},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 100},
    "codegraph": {"type": "boolean"},
    "codegraph_root": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task_class", "query", "fixture"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"},
          "task_class": {"type": "string", "minLength": 1, "maxLength": 80},
          "query": {"type": "string", "minLength": 1, "maxLength": 2000},
          "fixture": {"type": "string", "minLength": 1},
          "catalog": {"type": "string", "minLength": 1},
          "semantic_index": {"type": "string", "minLength": 1},
          "semantic_model": {"type": "string", "minLength": 1, "maxLength": 120},
          "top_k": {"type": "integer", "minimum": 1, "maximum": 100},
          "codegraph": {"type": "boolean"},
          "codegraph_root": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
