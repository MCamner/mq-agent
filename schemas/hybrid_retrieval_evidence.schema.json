{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mq.hybrid-retrieval-evidence-set.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","evidence_id","created_at","suite_sha256","status","zero_effect","promotion_eligible","cases","aggregate","limitations"],
  "properties": {
    "schema": {"const": "mq.hybrid-retrieval-evidence-set.v1"},
    "evidence_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "suite_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["PASS","INSUFFICIENT_EVIDENCE"]},
    "zero_effect": {"const": true},
    "promotion_eligible": {"const": false},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id","task_class","query_sha256","fixture_sha256","run_fingerprint","status","available_channels","unavailable_channels","skipped_channels","merged_result_count","metrics"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "task_class": {"type": "string", "minLength": 1, "maxLength": 80},
          "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fixture_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "run_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "channel_selection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["notebook_keyword","notebook_vector","codegraph"],
            "properties": {
              "notebook_keyword": {"type": "boolean"},
              "notebook_vector": {"type": "boolean"},
              "codegraph": {"type": "boolean"}
            }
          },
          "input_fingerprints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["notebook_catalog_sha256","notebook_semantic_index_sha256"],
            "properties": {
              "notebook_catalog_sha256": {"type": ["string","null"], "pattern": "^sha256:[0-9a-f]{64}$"},
              "notebook_semantic_index_sha256": {"type": ["string","null"], "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          },
          "status": {"enum": ["PASS","INSUFFICIENT_EVIDENCE"]},
          "available_channels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "unavailable_channels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "skipped_channels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "merged_result_count": {"type": "integer", "minimum": 0},
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["precision","recall","contradiction_rate","stale_rate","payload_token_estimate","active_payload_token_estimate","token_delta_vs_active","total_channel_latency_ms"],
            "properties": {
              "precision": {"type": ["number","null"], "minimum": 0, "maximum": 1},
              "recall": {"type": ["number","null"], "minimum": 0, "maximum": 1},
              "contradiction_rate": {"type": ["number","null"], "minimum": 0, "maximum": 1},
              "stale_rate": {"type": ["number","null"], "minimum": 0, "maximum": 1},
              "payload_token_estimate": {"type": "integer", "minimum": 0},
              "active_payload_token_estimate": {"type": ["integer","null"], "minimum": 0},
              "token_delta_vs_active": {"type": ["integer","null"]},
              "total_channel_latency_ms": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count","task_class_count","pass_count","insufficient_evidence_count","quality_measured_count","mean_precision","mean_recall","mean_contradiction_rate","mean_stale_rate","mean_token_delta_vs_active","mean_total_channel_latency_ms","channel_coverage"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "task_class_count": {"type": "integer", "minimum": 1},
        "pass_count": {"type": "integer", "minimum": 0},
        "insufficient_evidence_count": {"type": "integer", "minimum": 0},
        "quality_measured_count": {"type": "integer", "minimum": 0},
        "mean_precision": {"type": ["number","null"], "minimum": 0, "maximum": 1},
        "mean_recall": {"type": ["number","null"], "minimum": 0, "maximum": 1},
        "mean_contradiction_rate": {"type": ["number","null"], "minimum": 0, "maximum": 1},
        "mean_stale_rate": {"type": ["number","null"], "minimum": 0, "maximum": 1},
        "mean_token_delta_vs_active": {"type": ["number","null"]},
        "mean_total_channel_latency_ms": {"type": ["number","null"], "minimum": 0},
        "channel_coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["available","unavailable","skipped"],
            "properties": {
              "available": {"type": "integer", "minimum": 0},
              "unavailable": {"type": "integer", "minimum": 0},
              "skipped": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
