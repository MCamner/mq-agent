{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mq.feedback-promotion-approval.v1",
  "description": "Permission to activate one task-class strategy, bound to one exact PASS Canary v2 RESULT. Separate from the canary approval, which only permits testing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "promotion_approval_id",
    "canary_approval_id",
    "candidate_id",
    "candidate_fingerprint",
    "canary_id",
    "canary_result_fingerprint",
    "task_class",
    "current_strategy",
    "proposed_strategy",
    "policy_snapshot",
    "approved_at",
    "expires_at",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "mq.feedback-promotion-approval.v1"
    },
    "promotion_approval_id": {
      "type": "string",
      "pattern": "^approval-promotion-[A-Za-z0-9-]{8,}$"
    },
    "canary_approval_id": {
      "type": "string",
      "pattern": "^approval-[A-Za-z0-9-]{8,}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canary_id": {
      "type": "string",
      "pattern": "^canary-[A-Za-z0-9-]{8,}$"
    },
    "canary_result_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "current_strategy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "proposed_strategy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "policy_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_strategy",
        "event_count",
        "last_event_id"
      ],
      "properties": {
        "effective_strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_event_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        }
      }
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    }
  }
}
