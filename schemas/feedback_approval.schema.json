{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mq.feedback-approval.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","approval_id","candidate_id","candidate_fingerprint","task_class","current_strategy","proposed_strategy","rollback_target","evidence_window","approved_at","expires_at","reason"],
  "properties": {
    "schema": {"const":"mq.feedback-approval.v1"},
    "approval_id":{"type":"string","pattern":"^approval-[A-Za-z0-9-]{8,}$"},
    "candidate_id":{"type":"string","minLength":1,"maxLength":128},
    "candidate_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "task_class":{"type":"string","minLength":1,"maxLength":80},
    "current_strategy":{"type":"string","minLength":1,"maxLength":120},
    "proposed_strategy":{"type":"string","minLength":1,"maxLength":120},
    "rollback_target":{"type":"string","minLength":1,"maxLength":120},
    "evidence_window":{"type":"object","additionalProperties":false,"required":["from","to","comparison_ids"],"properties":{"from":{"type":"string","format":"date-time"},"to":{"type":"string","format":"date-time"},"comparison_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}}},
    "approved_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "reason":{"type":"string","minLength":1,"maxLength":320}
  }
}
