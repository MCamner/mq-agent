{
  "schema": "mq.verification-config.v1",
  "python_project": ".",
  "checks": [
    {
      "id": "verification-contracts",
      "runner": "pytest",
      "targets": [
        "tests/test_verify_changes.py",
        "tests/test_command_reference.py"
      ],
      "paths": [
        "mq_agent/verify_changes.py",
        "mq_agent/main.py",
        "tests/test_verify_changes.py",
        ".mq/verification.json",
        "tests/test_command_reference.py",
        "tools/generate_command_reference.py",
        "docs/generated/Command-Reference.md"
      ],
      "timeout_seconds": 60
    },
    {
      "id": "python-suite",
      "runner": "pytest",
      "targets": [
        "tests"
      ],
      "paths": [
        "mq_agent/*",
        "tests/*",
        "schemas/*",
        "pyproject.toml",
        "uv.lock"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "skills",
      "runner": "bash",
      "targets": [
        "scripts/check-skills.sh"
      ],
      "paths": [
        "skills/*",
        ".claude/skills/*",
        ".agents/skills/*",
        "SKILLS.md",
        "scripts/check-skills.sh"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "docs-consistency",
      "runner": "bash",
      "targets": [
        "scripts/check-docs-consistency.sh"
      ],
      "paths": [
        "README.md",
        "docs/*",
        "VERSION",
        "pyproject.toml"
      ],
      "timeout_seconds": 120
    }
  ]
}
