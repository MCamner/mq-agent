{
  "schema": "mq.verification-config.v1",
  "checks": [
    {
      "id": "verification-contracts",
      "runner": "pytest",
      "targets": [
        "tests/test_verify_changes.py",
        "tests/test_command_reference.py"
      ],
      "paths": [
        "mq_agent/verify_changes.py",
        "mq_agent/main.py",
        "tests/test_verify_changes.py",
        ".mq/verification.json",
        "tests/test_command_reference.py",
        "tools/generate_command_reference.py",
        "docs/generated/Command-Reference.md"
      ],
      "timeout_seconds": 60
    },
    {
      "id": "docs-consistency",
      "runner": "bash",
      "targets": [
        "scripts/check-docs-consistency.sh"
      ],
      "paths": [
        "README.md",
        "docs/*",
        "CHANGELOG.md"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "task-queue",
      "runner": "pytest",
      "targets": [
        "tests/test_task_queue.py",
        "tests/test_task_queue_cli.py"
      ],
      "paths": [
        "mq_agent/task_queue.py",
        "mq_agent/queue_cli.py",
        "mq_agent/main.py",
        "tests/test_task_queue.py",
        "tests/test_task_queue_cli.py",
        ".mq/verification.json"
      ],
      "timeout_seconds": 60
    },
    {
      "id": "execution-efficiency",
      "runner": "pytest",
      "targets": [
        "tests/test_execution_efficiency.py",
        "tests/test_execution_metrics.py",
        "tests/test_execution_outcome.py",
        "tests/test_execution_completeness.py",
        "tests/test_core.py",
        "tests/test_workflow_observation.py"
      ],
      "paths": [
        "mq_agent/core/execution_metrics.py",
        "mq_agent/core/planner.py",
        "mq_agent/core/verification.py",
        "mq_agent/core/executor.py",
        "mq_agent/core/task_runner.py",
        "mq_agent/core/local_llm.py",
        "mq_agent/core/swarm.py",
        "mq_agent/workflows/runner.py",
        "mq_agent/workflows/cli.py",
        "mq_agent/tools/model_runtime.py",
        "mq_agent/tools/execution_efficiency.py",
        "mq_agent/cli/execution_efficiency.py",
        "mq_agent/main.py",
        "tests/test_execution_efficiency.py",
        "tests/test_execution_metrics.py",
        ".mq/verification.json"
      ],
      "timeout_seconds": 90
    }
  ]
}
