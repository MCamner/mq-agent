# OpenAI credentials are not stored in .env.
# mq-agent uses an explicitly inherited OPENAI_API_KEY when present.
# On macOS it otherwise reads Apple Keychain service `mq-openai-api-key`,
# matching mq-mcp's credential behavior.
#
# Optional non-secret overrides:
# MQ_OPENAI_KEYCHAIN_SERVICE=mq-openai-api-key
# MQ_OPENAI_KEYCHAIN_ACCOUNT=<your-keychain-account>
