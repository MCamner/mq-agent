# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*

# Secrets / local config
*.key
*.pem
*.p12
*.pfx
.env.local
secrets.*
settings.local.json
.claude/settings.local.json
.claude/settings.json

# Logs
*.log
logs/

# Ephemeral / unsanitized agent scaffolding (keep local-only).
# Committed agent surfaces (AGENTS.md, CLAUDE.md, .mq/context/* cards) are owned and
# tracked by this repo; only the per-task pack and the stray template copies stay local.
.mq/context/task-pack.md
templates/AGENTS.md
templates/CLAUDE.md
.codegraph/

# Local MCP client configuration. Machine-specific absolute paths, which
# AGENTS.md forbids committing, and each operator's client differs.
.mcp.json
.cursor/mcp.json

# Disposable local NotebookLM Drive corpus state (contains real Drive IDs).
.mq/notebook-corpus/

# Hybrid Retrieval evidence working state. Candidate pools and run records are
# large machine-generated JSON holding real Drive IDs, and the labelling
# worksheet is scratch material regenerated from the pools on demand -- none of
# it is a deliverable, and the worksheet's HTML <details> blocks fail
# markdownlint. EXCLUSIONS.md is the exception and stays tracked: it is the
# record of which challenge cases were taken out of use and why, which has to
# be auditable after the fact or the reason is just a claim.
# The pattern is `/*` rather than `/` so the negation below can apply; git does
# not descend into a directory excluded by a trailing-slash pattern.
.mq/hybrid-challenge/*
!.mq/hybrid-challenge/EXCLUSIONS.md
.mq/hybrid-evidence/
